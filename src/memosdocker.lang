# ===========================================================================
# Multilingual file for the TOS 7 Docker application "memosdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Memos"
auth         = "usememos"
version      = "@@VERSION@@"
descript     = "Memos is a lightweight, self-hosted memo hub: a private place for quick notes, links and ideas. Write in Markdown, organise with tags, attach images, and share a single memo with a public link. It runs as one small container with an embedded SQLite database, so there is no database server to install, and everything you write stays in the application data folder on your NAS."
release_note = "1. Upgraded to Memos 26.11.1 from Docker Hub, still a non-root container; data written by 0.31.x is migrated automatically on first start (verified). 2. Review remediation: privacy policy published and linked from the app's Help field, licence attributions in NOTICE.md, data and third-party disclosures documented. 3. Re-verified on TOS 7: install, healthy, restart recovery, absolute data path."
important    = "Requires DockerEngine (installed automatically if missing). The first account you register becomes the administrator; notes, attachments and settings live in DockerAppData/memosdocker/data. The UI is plain HTTP - put it behind a TLS reverse proxy before exposing it. Back up the data folder before uninstalling with data removal; the container keeps no state. Memos is MIT-licensed and used unmodified; privacy policy: https://github.com/Moechz/memos/blob/main/PRIVACY.md"

[zh-cn]
name         = "Memos"
auth         = "usememos"
version      = "@@VERSION@@"
descript     = "Memos 是一款轻量的自托管速记本：随手记录笔记、链接和想法，数据完全留在自己的 NAS 上。支持 Markdown、标签、图片附件，单条 memo 还能生成公开分享链接。整个应用只有一个容器，内置 SQLite，无需额外安装数据库，所有内容都保存在应用数据目录中。"
release_note = "1. 升级到 Docker Hub 的 Memos 26.11.1，仍以非 root 容器运行；0.31.x 写入的数据在首次启动时自动迁移（已实测）。2. 按审核意见整改：发布隐私政策并链接到应用“帮助”入口，许可与署名见 NOTICE.md，数据采集与第三方调用已披露。3. 真机复测：安装、健康检查、重启恢复、绝对数据路径均通过。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。第一个注册的账号即管理员；笔记、附件与设置保存在 DockerAppData/memosdocker/data。界面为纯 HTTP，暴露到公网前请配置带 TLS 的反向代理。卸载并删除数据前请先备份数据目录；容器本身不保留状态。Memos 采用 MIT 许可且未作修改；隐私政策：https://github.com/Moechz/memos/blob/main/PRIVACY.md"

[zh-hk]
name         = "Memos"
auth         = "usememos"
version      = "@@VERSION@@"
descript     = "Memos 是一款輕量的自託管速記本：隨手記錄筆記、連結和想法，資料完全留在自己的 NAS 上。支援 Markdown、標籤、圖片附件，單條 memo 亦可產生公開分享連結。整個應用只有一個容器，內建 SQLite，無需額外安裝資料庫，所有內容都保存在應用資料目錄中。"
release_note = "1. 升級到 Docker Hub 的 Memos 26.11.1，仍以非 root 容器運行；0.31.x 寫入的資料在首次啟動時自動遷移（已實測）。2. 按審核意見整改：發佈隱私政策並連結到應用「說明」入口，許可與署名見 NOTICE.md，資料採集與第三方呼叫已披露。3. 真機複測：安裝、健康檢查、重啟恢復、絕對資料路徑均通過。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。首個註冊的帳號即管理員；筆記、附件與設定保存在 DockerAppData/memosdocker/data。介面為純 HTTP，公開到互聯網前請配置帶 TLS 的反向代理。解除安裝並刪除資料前請先備份資料目錄；容器本身不保留狀態。Memos 採用 MIT 許可且未作修改；隱私政策：https://github.com/Moechz/memos/blob/main/PRIVACY.md"

